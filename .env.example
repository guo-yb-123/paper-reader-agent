# --- LLM API（默认：阿里云通义千问） ---
LLM_API_KEY=your_dashscope_api_key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型（只用免费额度模型）
LLM_MODEL_CANDIDATES=qwen-turbo



# --- Embedding ---
EMBEDDING_PROVIDER=dashscope
EMBEDDING_MODEL=text-embedding-v2
# 备选：本地免费 Embedding
# EMBEDDING_PROVIDER=local

# --- 向量维度 ---
# dashscope text-embedding-v2: 1536
# local bge-small: 512
VECTOR_DIMENSION=1536

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=paper_reader
POSTGRES_PASSWORD=paper_reader_pass
POSTGRES_DB=paper_reader_db

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- 应用配置 ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- 文件存储 ---
PDF_STORAGE_DIR=./data/pdfs
PARSED_STORAGE_DIR=./data/parsed

# --- 向量配置 ---
VECTOR_CHUNK_SIZE=500
VECTOR_TOP_K=5
# 向量维度：local=bge-small=512, dashscope=text-embedding-v2=1536
VECTOR_DIMENSION=512
